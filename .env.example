# Copy this file to .env and fill in your API keys

# Choose one LLM provider: openai or gemini
LLM_PROVIDER=openai

# OpenAI API Key (required if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (required if using Gemini)
GOOGLE_API_KEY=your_google_api_key_here

# ChromaDB persistence directory (optional, defaults to ./chroma_db)
CHROMA_PERSIST_DIR=./chroma_db

# Uploads directory (optional, defaults to ./uploads)
UPLOADS_DIR=./uploads
